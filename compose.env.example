# Copiar como .env.compose (privado). No reutilizar el .env de la app local.
# Generar DOS valores distintos con: openssl rand -hex 32
# POSTGRES_PASSWORD debe ser hexadecimal para usarlo directamente en DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
APP_PORT=3000
IMAGE_TAG=latest
# Solo para crear el primer administrador. Quitar ADMIN_PASSWORD después.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
