{
  "name": "dragon-vault",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "catalog:check": "node scripts/catalog-updater.mjs",
    "catalog:sets": "node scripts/sync-sets.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:spanish": "node scripts/sync-spanish.mjs",
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/setup-auth.mjs",
    "db:admin": "node --env-file-if-exists=.env scripts/setup-auth.mjs --admin",
    "test:auth:integration": "node --test tests/integration/auth.mjs",
    "test:auth:browser": "playwright test -c playwright.auth.config.js"
  },
  "dependencies": {
    "@nuxt/ui": "^4.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "nuxt": "^4.0.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
